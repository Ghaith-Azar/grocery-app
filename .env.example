# Copy this file to .env for local testing (optional — the app falls back
# to a local SQLite file called local.db if these are not set).
# In Render, set these as real Environment Variables instead of a .env file.

TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
